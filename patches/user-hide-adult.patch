+
+    fn blank_xtream_item() -> XtreamPlaylistItem {
+        XtreamPlaylistItem {
+            virtual_id: 0,
+            provider_id: 0,
+            name: "".intern(),
+            logo: "".intern(),
+            logo_small: "".intern(),
+            group: "".intern(),
+            title: "".intern(),
+            parent_code: "".intern(),
+            rec: "".intern(),
+            url: "".intern(),
+            epg_channel_id: None,
+            xtream_cluster: XtreamCluster::Live,
+            additional_properties: None,
+            item_type: PlaylistItemType::Live,
+            category_id: 0,
