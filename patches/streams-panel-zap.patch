     // hard-remove every HLS chunk and Streams blinks even when frontend soft-preserve is present.
     stream.channel.item_type == PlaylistItemType::Catchup
         || stream.channel.item_type.is_live_adaptive()
+        || (stream.channel.item_type == PlaylistItemType::Live && stream.session_token.is_some())
         || stream.session_token.as_deref().is_some_and(is_catchup_session_token)
         || matches!(
             extract_extension_from_url(stream.channel.url.as_ref()),
@@ -959,6 +960,14 @@ impl ActiveUserManager {
                     let mut removed_session_tokens = HashSet::new();
                     let mut preserved_session_tokens = Vec::new();
                     let now = current_time_secs();
+                    let other_active_by_client: HashSet<(String, u32)> = connection_data
+                        .streams
+                        .iter()
+                        .filter(|stream| {
+                            stream.addr != *addr && !stream.preserved && Self::should_preserve_session_stream(stream)
+                        })
+                        .map(|stream| (stream.client_ip.clone(), stream.channel.virtual_id))
+                        .collect();
                     for mut stream_info in connection_data.streams.drain(..) {
                         if stream_info.addr == *addr {
                             let migrated_addr = stream_info
@@ -971,7 +980,12 @@ impl ActiveUserManager {
                                 stream_info.addr = next_addr;
                                 stream_info.ts = now;
                                 remaining_streams.push(stream_info);
-                            } else if preserve_session_streams && Self::should_preserve_session_stream(&stream_info) {
+                            } else if preserve_session_streams
+                                && Self::should_preserve_session_stream(&stream_info)
+                                && !other_active_by_client.iter().any(|(ip, vid)| {
+                                    *vid != stream_info.channel.virtual_id && ip == &stream_info.client_ip
+                                })
+                            {
                                 if let Some(entry) = self.build_preserved_stream_expiry(
                                     username,
                                     &stream_info,
@@ -1645,7 +1659,10 @@ impl ActiveUserManager {
         // row using the stream timestamp so Streams does not blink between archive chunks.
         let session_ts = if let Some(session) = sessions.iter().find(|session| session.token == session_token) {
             session.ts
-        } else if stream.channel.item_type == PlaylistItemType::Catchup || is_catchup_session_token(session_token) {
+        } else if stream.channel.item_type == PlaylistItemType::Catchup
+            || is_catchup_session_token(session_token)
+            || (stream.channel.item_type == PlaylistItemType::Live && stream.session_token.is_some())
+        {
             stream.ts
         } else {
             return None;
@@ -1916,10 +1933,9 @@ impl ActiveUserManager {
         if admission.permission == UserConnectionPermission::Allowed {
             let session = &mut connection_data.sessions[session_index];
             Self::update_session_admission(session, admission.permission, Some(kind));
-            if has_preserved {
-                connection_data.increment_kind(kind);
-            }
         }
+        // Do not increment for preserved streams here: `update_connection` already increments
+        // on `was_preserved` reactivate. Double-increment left ghost `active_user_connections`.
         if has_preserved {
             return ConnectionAdmission { permission: UserConnectionPermission::Exhausted, kind: admission.kind };
         }
