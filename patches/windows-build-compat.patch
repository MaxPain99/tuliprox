# =============================================================================
# [BitTV fork] windows-build-compat.patch
# Upstream v3.3.76 does not currently compile for Windows targets:
# - memmap2::Advice / Mmap::advise are Unix-only
# - GetDiskFreeSpaceExW expects *mut ULARGE_INTEGER (not &mut u64)
# - Windows Sampler holds a raw HANDLE and is not Send for tokio::spawn
# Apply FIRST, before MaxPain feature patches.
# =============================================================================

