# MaxPain fix-hls-soft-preserve-reactivation.patch
#
# Upstream regression since euzu/tuliprox#807 (v3.3.79):
# LiveHls segment gaps soft-preserve the stream, then next segment Activate returned
# Exhausted and kick-evicted the SAME session (retry storm / disconnect).
# Restore 3.3.78 entitlement via session_has_stream (includes preserved).
# Remove unused session_has_active_stream helper (dead_code with -D warnings).
# Keep #815 ghost-slot fix (no increment_kind on preserved reactivation).
#
diff --git a/backend/src/api/model/active_user_manager.rs b/backend/src/api/model/active_user_manager.rs
