+/// Nested URL dispatch (`.../{id}/{file}`):
+/// - `archive-*` / `timeshift_*` → Flussonic only
+/// - live file + `?utc=&lutc=` → Flussonic archive
+/// - live file otherwise → live
+/// Shift channels never use this URL shape.
+fn resolve_nested_m3u_playback<'a>(
+    pli: shared::model::M3uPlaylistItem,
+    input: &crate::model::ConfigInput,
+    file: &'a str,
+    raw_query: Option<&str>,
+) -> Result<(shared::model::M3uPlaylistItem, Option<String>, Option<&'a str>), TuliproxError> {
+    let stream_ext = extract_extension_from_url(file);
+
+    if let Some(archive) = parse_flussonic_archive_file(file) {
+        if !playlist_item_is_flussonic(&pli) {
+            return Err(TuliproxError::RepositoryM3u(
+                "Flussonic archive path is only valid for flussonic catchup channels".to_string(),
+            ));
+        }
+        let (item, disc) = apply_flussonic_archive(&pli, input, &archive)?;
+        return Ok((item, Some(disc), stream_ext.or(Some(HLS_EXT))));
+    }
+
+    if is_flussonic_live_file(file) {
+        if playlist_item_is_flussonic(&pli) {
+            if let Some(query) = raw_query.filter(|q| !q.is_empty()) {
+                if let Some(archive) = flussonic_archive_from_utc_lutc_query(query) {
+                    let (item, disc) = apply_flussonic_archive(&pli, input, &archive)?;
+                    return Ok((item, Some(disc), stream_ext.or(Some(HLS_EXT))));
+                }
+            }
+        }
+        // Live playback (flussonic index.m3u8 or accidental nested hit).
+        return Ok((pli, None, stream_ext));
+    }
+
+    Err(TuliproxError::RepositoryM3u(format!(
+        "Unsupported nested M3U stream file: {file}"
+    )))
+}
