+
+    fn is_flussonic_mode_str(mode: Option<&str>) -> bool {
+        mode.is_some_and(|m| {
+            matches!(
+                m.trim().to_ascii_lowercase().as_str(),
+                "flussonic" | "flussonic-hls" | "flussonic-ts" | "fs"
+            )
+        })
+    }
+
+    /// True when catchup / catchup-type is a Flussonic family mode.
+    ///
+    /// Prefer `catchup-type` when both are set so a leftover `catchup="shift"` from a
+    /// provider cannot steal Flussonic path-rewrite channels (and vice versa).
+    pub fn is_flussonic(&self) -> bool {
+        if let Some(ct) = self.catchup_type.as_deref().filter(|v| !v.is_empty()) {
+            return Self::is_flussonic_mode_str(Some(ct));
+        }
+        Self::is_flussonic_mode_str(self.mode.as_deref())
+    }
+
+    /// Value for the M3U `catchup=` attribute that TiviMate understands for Flussonic.
+    ///
+    /// TiviMate rewrites the live URL path for these modes. Providers like BitTV often
+    /// ship `catchup-type` + `timeshift` instead of `catchup=` — export should keep those
+    /// without inventing a `catchup=` attribute. Never emit a shift-style `catchup-source`.
+    pub fn flussonic_player_mode(&self) -> Option<&'static str> {
+        if !self.is_flussonic() {
+            return None;
+        }
+        let raw = self
+            .catchup_type
+            .as_deref()
+            .filter(|v| !v.is_empty())
+            .or(self.mode.as_deref())
+            .unwrap_or("flussonic");
+        if raw.eq_ignore_ascii_case("flussonic-ts") {
+            Some("flussonic-ts")
+        } else {
+            Some("flussonic")
+        }
     }
 }
 
