+//! Flussonic-compatible M3U archive paths for reverse-proxied playlists.
+//!
+//! TiviMate (`catchup="flussonic"` / `catchup-type="flussonic"`) rewrites the last
+//! path segment of the live URL by keeping the playlist stem:
+//!   `.../{id}/index.m3u8`  -> `.../{id}/index-{utc}-{duration}.m3u8`
+//!   `.../{id}/video.m3u8`  -> `.../{id}/video-{utc}-{duration}.m3u8`
+//!   `.../{id}/mono.m3u8`   -> `.../{id}/mono-{utc}-{duration}.m3u8`
+//! Some clients / docs also use `archive-{utc}-{duration}.m3u8`.
+//! It does **not** use `catchup-source` and does **not** append `?utc=&lutc=`
+//! (that is the `shift` mode).
+
+use url::Url;
+
+/// Live file name used in proxied Flussonic HLS URLs (`{id}/index.m3u8`).
+pub const FLUSSONIC_PROXY_LIVE_FILE: &str = "index.m3u8";
+/// Live file name used in proxied Flussonic MPEG-TS URLs (`{id}/mpegts`).
+pub const FLUSSONIC_TS_PROXY_LIVE_FILE: &str = "mpegts";
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum FlussonicArchiveKind {
+    /// `{archive|index|video|mono}-{start}-{duration}.m3u8`
+    ArchiveHls { start: String, duration: String },
+    /// `timeshift_abs-{start}.m3u8` / `.ts`
+    TimeshiftAbs { start: String, extension: String },
+    /// `timeshift_rel-{ago}.m3u8`
+    TimeshiftRel { ago: String },
+}
+
+impl FlussonicArchiveKind {
+    pub fn discriminator(&self) -> String {
+        match self {
+            Self::ArchiveHls { start, duration } => format!("archive|{start}|{duration}"),
+            Self::TimeshiftAbs { start, .. } => format!("timeshift_abs|{start}"),
+            Self::TimeshiftRel { ago } => format!("timeshift_rel|{ago}"),
+        }
+    }
+
+    pub fn epg_reference_ts(&self) -> Option<i64> {
+        match self {
+            Self::ArchiveHls { start, .. } | Self::TimeshiftAbs { start, .. } => start.parse().ok(),
+            Self::TimeshiftRel { .. } => None,
+        }
+    }
+}
+
+fn strip_media_suffix(name: &str) -> &str {
+    name.strip_suffix(".m3u8")
+        .or_else(|| name.strip_suffix(".M3U8"))
+        .or_else(|| name.strip_suffix(".ts"))
+        .or_else(|| name.strip_suffix(".TS"))
+        .unwrap_or(name)
+}
+
+fn split_start_duration(rest: &str) -> Option<(&str, &str)> {
+    let mut parts = rest.splitn(2, '-');
+    let start = parts.next()?.trim();
+    let duration = parts.next()?.trim();
+    if start.is_empty() || duration.is_empty() {
+        return None;
+    }
+    if start.parse::<i64>().is_err() {
+        return None;
+    }
+    // Flussonic allows numeric duration or `now` (event playlist until live edge).
+    let duration_ok = duration.eq_ignore_ascii_case("now") || duration.parse::<i64>().is_ok();
+    if !duration_ok {
+        return None;
+    }
+    Some((start, duration))
+}
+
+/// Parse `{stem}-{start}-{duration}` where stem is archive/index/video/mono.
+fn parse_stem_timed_archive(file: &str) -> Option<FlussonicArchiveKind> {
+    let lower = file.to_ascii_lowercase();
+    for stem in ["archive-", "index-", "video-", "mono-"] {
+        if let Some(rest) = lower.strip_prefix(stem) {
+            let rest = strip_media_suffix(rest);
+            let (start, duration) = split_start_duration(rest)?;
+            return Some(FlussonicArchiveKind::ArchiveHls {
+                start: start.to_string(),
+                duration: duration.to_string(),
+            });
+        }
+    }
+    None
+}
+
+/// Parse a Flussonic archive / timeshift filename from the last URL path segment.
+pub fn parse_flussonic_archive_file(file: &str) -> Option<FlussonicArchiveKind> {
+    let file = file.trim().trim_start_matches('/');
+    if file.is_empty() {
+        return None;
+    }
+
+    if let Some(archive) = parse_stem_timed_archive(file) {
+        return Some(archive);
+    }
+
+    let lower = file.to_ascii_lowercase();
+    if let Some(rest) = lower.strip_prefix("timeshift_abs-") {
+        let (start, extension) = if rest.ends_with(".m3u8") {
+            (strip_media_suffix(rest), ".m3u8")
+        } else if rest.ends_with(".ts") {
+            (strip_media_suffix(rest), ".ts")
+        } else {
+            (rest, ".m3u8")
+        };
+        let start = start.trim();
+        if start.is_empty() || start.parse::<i64>().is_err() {
+            return None;
+        }
+        return Some(FlussonicArchiveKind::TimeshiftAbs {
+            start: start.to_string(),
+            extension: extension.to_string(),
+        });
+    }
+
+    if let Some(rest) = lower.strip_prefix("timeshift_rel-") {
+        let ago = strip_media_suffix(rest)
+            .trim_start_matches('-')
+            .trim_start_matches('+')
+            .trim();
+        if ago.is_empty() {
+            return None;
+        }
+        return Some(FlussonicArchiveKind::TimeshiftRel { ago: ago.to_string() });
+    }
+
+    None
+}
+
+/// True when the nested path file is a live Flussonic entry (not archive).
+pub fn is_flussonic_live_file(file: &str) -> bool {
+    let file = file.trim().trim_start_matches('/').to_ascii_lowercase();
+    matches!(
+        file.as_str(),
+        "index.m3u8"
+            | "video.m3u8"
+            | "mono.m3u8"
+            | "mpegts"
+            | "index.ts"
+            | "video.ts"
+            | "mono.ts"
+    )
+}
+
+fn replace_last_path_segment(url: &str, new_file: &str) -> Option<String> {
+    let mut parsed = Url::parse(url).ok()?;
+    {
+        let mut segments: Vec<String> = parsed.path_segments()?.map(ToString::to_string).collect();
+        if segments.is_empty() {
+            segments.push(new_file.to_string());
+        } else {
+            *segments.last_mut()? = new_file.to_string();
+        }
+        parsed.set_path(&format!("/{}", segments.join("/")));
+    }
+    Some(parsed.into())
+}
+
+/// Live playlist stem (`index` / `video` / `mono`) from a provider URL, if any.
+fn provider_live_playlist_stem(provider_live_url: &str) -> Option<&'static str> {
+    let parsed = Url::parse(provider_live_url).ok()?;
+    let file = parsed.path_segments()?.next_back()?.to_ascii_lowercase();
+    match file.as_str() {
+        "index.m3u8" | "index.ts" => Some("index"),
+        "video.m3u8" | "video.ts" => Some("video"),
+        "mono.m3u8" | "mono.ts" => Some("mono"),
+        _ => None,
+    }
+}
+
+/// Build the upstream Flussonic archive URL from the provider live URL.
+///
+/// Prefer `{live_stem}-{start}-{duration}.m3u8` when the provider live file is
+/// `index`/`video`/`mono` (BitTV / TiviMate style). Otherwise use `archive-…`.
+pub fn build_provider_flussonic_archive_url(
+    provider_live_url: &str,
+    archive: &FlussonicArchiveKind,
+) -> Option<String> {
+    let new_file = match archive {
+        FlussonicArchiveKind::ArchiveHls { start, duration } => {
+            let stem = provider_live_playlist_stem(provider_live_url).unwrap_or("archive");
+            format!("{stem}-{start}-{duration}.m3u8")
+        }
+        FlussonicArchiveKind::TimeshiftAbs { start, extension } => {
+            format!("timeshift_abs-{start}{extension}")
+        }
+        FlussonicArchiveKind::TimeshiftRel { ago } => format!("timeshift_rel-{ago}.m3u8"),
+    };
+    replace_last_path_segment(provider_live_url, &new_file)
+}
+
+/// Build Flussonic archive spec from a shift-style `utc`/`lutc` query (fallback).
+pub fn flussonic_archive_from_utc_lutc_query(query: &str) -> Option<FlussonicArchiveKind> {
+    let mut utc = None;
+    let mut lutc = None;
+    for (key, value) in url::form_urlencoded::parse(query.as_bytes()) {
+        if key.eq_ignore_ascii_case("utc") {
+            utc = Some(value.into_owned());
+        } else if key.eq_ignore_ascii_case("lutc") {
+            lutc = Some(value.into_owned());
+        }
+    }
+    let start = utc.filter(|v| !v.is_empty())?;
+    let duration = match (start.parse::<i64>(), lutc.as_deref().and_then(|v| v.parse::<i64>().ok())) {
+        (Ok(s), Some(e)) if e > s => (e - s).to_string(),
+        _ => "14400".to_string(),
+    };
+    Some(FlussonicArchiveKind::ArchiveHls { start, duration })
+}
+
+/// Proxy live file for a Flussonic player mode (`flussonic` / `flussonic-ts`).
+pub fn flussonic_proxy_live_file(player_mode: &str) -> &'static str {
+    if player_mode.eq_ignore_ascii_case("flussonic-ts") {
+        FLUSSONIC_TS_PROXY_LIVE_FILE
+    } else {
+        FLUSSONIC_PROXY_LIVE_FILE
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_archive_hls_file() {
+        let archive = parse_flussonic_archive_file("archive-1700000000-3600.m3u8").unwrap();
+        assert_eq!(
+            archive,
+            FlussonicArchiveKind::ArchiveHls {
+                start: "1700000000".into(),
+                duration: "3600".into(),
+            }
+        );
+        assert_eq!(archive.epg_reference_ts(), Some(1_700_000_000));
+    }
+
+    #[test]
+    fn parses_tivimate_video_timed_file() {
+        // Real TiviMate 5.3.3 request against nested proxy live `…/video.m3u8` or
+        // stem rewrite to video-{utc}-{duration}.m3u8.
+        let archive = parse_flussonic_archive_file("video-1784898000-3600.m3u8").unwrap();
+        assert_eq!(
+            archive,
+            FlussonicArchiveKind::ArchiveHls {
+                start: "1784898000".into(),
+                duration: "3600".into(),
+            }
+        );
+    }
+
+    #[test]
+    fn parses_index_and_mono_timed_files() {
+        assert!(parse_flussonic_archive_file("index-1700000000-1800.m3u8").is_some());
+        assert!(parse_flussonic_archive_file("mono-1700000000-now.m3u8").is_some());
+    }
+
+    #[test]
+    fn builds_provider_archive_url_matching_live_stem() {
+        let archive = FlussonicArchiveKind::ArchiveHls {
+            start: "1700000000".into(),
+            duration: "3600".into(),
+        };
+        let url = build_provider_flussonic_archive_url(
+            "http://cdn.example/ch/index.m3u8?token=abc",
+            &archive,
+        )
+        .unwrap();
+        assert_eq!(url, "http://cdn.example/ch/index-1700000000-3600.m3u8?token=abc");
+    }
+
+    #[test]
+    fn builds_provider_archive_url_fallback_archive_stem() {
+        let archive = FlussonicArchiveKind::ArchiveHls {
+            start: "1700000000".into(),
+            duration: "3600".into(),
+        };
+        let url = build_provider_flussonic_archive_url(
+            "http://cdn.example/live/ch.ts?token=abc",
+            &archive,
+        )
+        .unwrap();
+        assert_eq!(url, "http://cdn.example/live/archive-1700000000-3600.m3u8?token=abc");
+    }
+
+    #[test]
+    fn live_files_detected() {
+        assert!(is_flussonic_live_file("index.m3u8"));
+        assert!(is_flussonic_live_file("video.m3u8"));
+        assert!(is_flussonic_live_file("mpegts"));
+        assert!(!is_flussonic_live_file("video-1-2.m3u8"));
+        assert!(!is_flussonic_live_file("archive-1-2.m3u8"));
+    }
+
+    #[test]
+    fn archive_from_utc_lutc_query() {
+        let archive = flussonic_archive_from_utc_lutc_query("utc=1700000000&lutc=1700003600").unwrap();
+        assert_eq!(
+            archive,
+            FlussonicArchiveKind::ArchiveHls {
+                start: "1700000000".into(),
+                duration: "3600".into(),
+            }
+        );
+    }
+}
