+fn m3u_archive_query_from_request(
+    request_query: Option<&str>,
+    api_req: &UserApiRequest,
+) -> Option<String> {
+    if let Some(q) = request_query.filter(|q| !q.is_empty()) {
+        if is_m3u_archive_playback_query(Some(q)) {
+            return Some(q.to_string());
+        }
+    }
+    let mut pairs = Vec::new();
+    if !api_req.start.is_empty() {
+        pairs.push(format!("start={}", api_req.start));
+    }
+    if !api_req.end.is_empty() {
+        pairs.push(format!("end={}", api_req.end));
+    }
+    if !api_req.duration.is_empty() {
+        pairs.push(format!("duration={}", api_req.duration));
+    }
+    if pairs.is_empty() {
+        return None;
+    }
+    let q = pairs.join("&");
+    is_m3u_archive_playback_query(Some(&q)).then_some(q)
+}
+
+fn m3u_catchup_session_discriminator(
+    archive_discriminator: Option<&str>,
+    raw_query: Option<&str>,
+    api_req: &UserApiRequest,
+    stream_url: &str,
+) -> String {
+    let base = archive_discriminator.unwrap_or("live");
+    let synthetic = m3u_archive_query_from_request(raw_query, api_req);
+    let utc = synthetic
+        .as_deref()
+        .and_then(archive_epg_reference_from_query)
+        .or_else(|| raw_query.and_then(archive_epg_reference_from_query))
+        .or_else(|| m3u_archive_epg_reference_ts(stream_url));
+    if let Some(utc) = utc {
+        return format!("{base}|{utc}");
+    }
+    base.to_string()
+}
+
+fn resolve_classic_m3u_archive(
+    mut pli: M3uPlaylistItem,
+    input: &ConfigInput,
+    raw_query: Option<&str>,
+    api_req: &UserApiRequest,
+) -> Result<(M3uPlaylistItem, String), TuliproxError> {
+    let Some(archive_query) = m3u_archive_query_from_request(raw_query, api_req) else {
+        return Err(TuliproxError::RepositoryM3u(
+            "not a classic archive query".to_string(),
+        ));
+    };
+    let attrs = catchup_attrs_from_item(&pli);
+    if attrs.is_empty() {
+        return Err(TuliproxError::RepositoryM3u(
+            "M3U archive metadata missing (reload playlist)".to_string(),
+        ));
+    }
+    let source_url = resolve_effective_source_url(&pli, input)?;
+    let archive_url = build_m3u_archive_provider_url(source_url.as_ref(), &archive_query, &attrs);
+    pli.item_type = PlaylistItemType::Catchup;
+    pli.url = archive_url.into();
+    Ok((pli, "classic".to_string()))
+}
