+fn playlist_item_catchup(pli: &shared::model::M3uPlaylistItem) -> Option<&shared::model::CatchupProperties> {
+    match pli.additional_properties.as_ref()? {
+        shared::model::StreamProperties::Live(live) => live.catchup.as_ref(),
+        _ => None,
+    }
