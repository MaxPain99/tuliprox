+fn playlist_item_is_flussonic(pli: &shared::model::M3uPlaylistItem) -> bool {
+    playlist_item_catchup(pli).is_some_and(shared::model::CatchupProperties::is_flussonic)
+}
+
+/// Apply a resolved Flussonic archive to a playlist item for playback.
+fn apply_flussonic_archive(
+    pli: &shared::model::M3uPlaylistItem,
+    input: &crate::model::ConfigInput,
+    archive: &crate::utils::FlussonicArchiveKind,
+) -> Result<(shared::model::M3uPlaylistItem, String), TuliproxError> {
+    let source_url = resolve_effective_source_url(pli, input)?;
+    let Some(archive_url) = build_provider_flussonic_archive_url(source_url.as_ref(), archive) else {
+        return Err(TuliproxError::RepositoryM3u(
+            "Failed to build Flussonic archive URL".to_string(),
+        ));
+    };
+    let mut catchup_item = pli.clone();
+    catchup_item.item_type = PlaylistItemType::Catchup;
+    catchup_item.url = archive_url.intern();
+    Ok((catchup_item, archive.discriminator()))
+}
