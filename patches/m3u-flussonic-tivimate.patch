+fn playlist_item_catchup(pli: &shared::model::M3uPlaylistItem) -> Option<&shared::model::CatchupProperties> {
+    match pli.additional_properties.as_ref()? {
+        shared::model::StreamProperties::Live(live) => live.catchup.as_ref(),
+        _ => None,
+    }
+}
+
+fn playlist_item_is_flussonic(pli: &shared::model::M3uPlaylistItem) -> bool {
+    playlist_item_catchup(pli).is_some_and(shared::model::CatchupProperties::is_flussonic)
+}
+
+/// Apply a resolved Flussonic archive to a playlist item for playback.
+fn apply_flussonic_archive(
+    pli: &shared::model::M3uPlaylistItem,
+    input: &crate::model::ConfigInput,
+    archive: &crate::utils::FlussonicArchiveKind,
+) -> Result<(shared::model::M3uPlaylistItem, String), TuliproxError> {
+    let source_url = resolve_effective_source_url(pli, input)?;
+    let Some(archive_url) = build_provider_flussonic_archive_url(source_url.as_ref(), archive) else {
+        return Err(TuliproxError::RepositoryM3u(
+            "Failed to build Flussonic archive URL".to_string(),
+        ));
+    };
+    let mut catchup_item = pli.clone();
+    catchup_item.item_type = PlaylistItemType::Catchup;
+    catchup_item.url = archive_url.intern();
+    Ok((catchup_item, archive.discriminator()))
+}
+
+/// Shift / append / xc / token catchup — never used for Flussonic channels.
+fn resolve_shift_style_m3u_catchup(
+    pli: &shared::model::M3uPlaylistItem,
+    input: &crate::model::ConfigInput,
+    raw_query: Option<&str>,
+) -> Result<(shared::model::M3uPlaylistItem, String), TuliproxError> {
+    let Some(catchup) = playlist_item_catchup(pli) else {
+        return Err(TuliproxError::RepositoryM3u("M3U catchup metadata missing".to_string()));
+    };
+    if catchup.is_flussonic() {
+        return Err(TuliproxError::RepositoryM3u(
+            "Flussonic catchup must use path rewrite, not shift collectors".to_string(),
+        ));
+    }
+    let source_url = resolve_effective_source_url(pli, input)?;
+    let Some(resolved) = resolve_m3u_catchup_url(source_url.as_ref(), catchup, raw_query)? else {
+        return Err(TuliproxError::RepositoryM3u("M3U catchup mode cannot be proxied".to_string()));
+    };
+    let mut catchup_item = pli.clone();
+    catchup_item.item_type = PlaylistItemType::Catchup;
+    catchup_item.url = resolved.url.into();
+    Ok((catchup_item, resolved.discriminator))
+}
+
+/// Flat URL dispatch (`.../{id}.m3u8`):
+/// - Flussonic → only `?utc=&lutc=` → provider archive path (no shift templates)
+/// - Shift/append → marker / `utc`/`lutc` / `v0`… → template collectors
+fn resolve_flat_m3u_catchup_if_needed(
+    pli: shared::model::M3uPlaylistItem,
+    input: &crate::model::ConfigInput,
+    raw_query: Option<&str>,
+) -> Result<(shared::model::M3uPlaylistItem, Option<String>), TuliproxError> {
+    if playlist_item_is_flussonic(&pli) {
+        if let Some(query) = raw_query.filter(|q| !q.is_empty()) {
+            if let Some(archive) = flussonic_archive_from_utc_lutc_query(query) {
+                let (item, disc) = apply_flussonic_archive(&pli, input, &archive)?;
+                return Ok((item, Some(disc)));
+            }
+        }
+        // Flussonic live (or unrelated query) — do not enter shift resolver.
+        return Ok((pli, None));
+    }
+
+    if has_m3u_catchup_marker(raw_query) {
+        let (item, disc) = resolve_shift_style_m3u_catchup(&pli, input, raw_query)?;
+        return Ok((item, Some(disc)));
+    }
+    Ok((pli, None))
+}
+
+/// Nested URL dispatch (`.../{id}/{file}`):
+/// - `archive-*` / `timeshift_*` → Flussonic only
+/// - live file + `?utc=&lutc=` → Flussonic archive
+/// - live file otherwise → live
+/// Shift channels never use this URL shape.
+fn resolve_nested_m3u_playback<'a>(
+    pli: shared::model::M3uPlaylistItem,
+    input: &crate::model::ConfigInput,
+    file: &'a str,
+    raw_query: Option<&str>,
+) -> Result<(shared::model::M3uPlaylistItem, Option<String>, Option<&'a str>), TuliproxError> {
+    let stream_ext = extract_extension_from_url(file);
+
+    if let Some(archive) = parse_flussonic_archive_file(file) {
+        if !playlist_item_is_flussonic(&pli) {
+            return Err(TuliproxError::RepositoryM3u(
+                "Flussonic archive path is only valid for flussonic catchup channels".to_string(),
+            ));
+        }
+        let (item, disc) = apply_flussonic_archive(&pli, input, &archive)?;
+        return Ok((item, Some(disc), stream_ext.or(Some(HLS_EXT))));
+    }
+
+    if is_flussonic_live_file(file) {
+        if playlist_item_is_flussonic(&pli) {
+            if let Some(query) = raw_query.filter(|q| !q.is_empty()) {
+                if let Some(archive) = flussonic_archive_from_utc_lutc_query(query) {
+                    let (item, disc) = apply_flussonic_archive(&pli, input, &archive)?;
+                    return Ok((item, Some(disc), stream_ext.or(Some(HLS_EXT))));
+                }
+            }
+        }
+        // Live playback (flussonic index.m3u8 or accidental nested hit).
+        return Ok((pli, None, stream_ext));
+    }
+
+    Err(TuliproxError::RepositoryM3u(format!(
+        "Unsupported nested M3U stream file: {file}"
+    )))
+}
