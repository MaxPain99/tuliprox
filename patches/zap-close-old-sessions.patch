+    /// On channel zap (`Activate` for a new `virtual_id`), drop other sessions for the
+    /// same user + client (IP and/or fingerprint key) so soft-preserved adaptive/HLS/Catchup
+    /// rows and provider pins do not linger until `hls_session_ttl`.
+    ///
+    /// Same-channel segment gaps keep the same `virtual_id` and are not terminated.
+    /// Other devices (different client IP) are left alone.
+    ///
+    /// Returns `(session_token, socket addrs, removed stream addr/uid pairs)` for each
+    /// removed session/orphan group so the caller can close sockets, clear provider
+    /// reservations, and hard-remove Streams panel rows.
+    pub async fn terminate_other_channel_sessions_for_client_ip(
+        &self,
+        username: &str,
+        client_ip: &str,
+        client_fingerprint: Option<&str>,
+        keep_virtual_id: u32,
+    ) -> Vec<(String, Vec<SocketAddr>, Vec<(SocketAddr, u32)>)> {
+        let client_ip_addr = Self::parse_client_ip(client_ip);
+        let normalized_client_ip = Self::normalize_client_ip(client_ip);
+
+        let (terminated, connection_changed, promotions) = {
+            let mut user_connections = self.connections.write().await;
+            let Some(connection_data) = user_connections.by_key.get_mut(username) else {
+                return Vec::new();
+            };
+
+            // Single-client zap users: only one distinct client IP (or all match the zap IP).
+            // Close every other virtual_id for that client, even when socket-bound tokens
+            // do not embed a fingerprint key.
+            let distinct_ips: HashSet<String> = connection_data
+                .streams
+                .iter()
+                .map(|s| Self::normalize_client_ip(&s.client_ip))
+                .filter(|ip| !ip.is_empty())
+                .collect();
+            let single_client_user = distinct_ips.len() <= 1
+                || distinct_ips.iter().all(|ip| ip == &normalized_client_ip);
+
+            let tokens_to_remove: Vec<String> = connection_data
+                .sessions
+                .iter()
+                .filter(|session| {
+                    session.virtual_id != keep_virtual_id
+                        && (single_client_user
+                            || Self::session_matches_client(
+                                session,
+                                &connection_data.streams,
+                                client_ip,
+                                client_ip_addr,
+                                &normalized_client_ip,
+                                client_fingerprint,
+                            ))
+                })
+                .map(|session| session.token.clone())
+                .collect();
+
+            let mut terminated = Vec::with_capacity(tokens_to_remove.len().saturating_add(1));
+            let mut connection_changed = false;
+
+            for token in &tokens_to_remove {
+                let Some(session_index) = connection_data.sessions.iter().position(|s| s.token == *token) else {
+                    continue;
+                };
+
+                let mut addrs = Vec::new();
+                let mut removed_streams = Vec::new();
+                let session_addr = connection_data.sessions[session_index].addr;
+                if !session_addr.ip().is_unspecified() {
+                    addrs.push(session_addr);
+                }
+                for addr in &connection_data.sessions[session_index].active_addrs {
+                    if !addrs.contains(addr) {
+                        addrs.push(*addr);
+                    }
+                }
+                for stream in connection_data
+                    .streams
+                    .iter()
+                    .filter(|stream| stream.session_token.as_deref() == Some(token.as_str()))
+                {
+                    if !addrs.contains(&stream.addr) {
+                        addrs.push(stream.addr);
+                    }
+                    removed_streams.push((stream.addr, stream.uid));
+                }
+
+                let counted_kind = connection_data.sessions[session_index]
+                    .lifecycle
+                    .is_counted()
+                    .then(|| connection_data.sessions[session_index].connection_kind.unwrap_or(ConnectionKind::Normal));
+                let (_, session_connection_changed) =
+                    connection_data.remove_streams_for_session_and_release_counted(token, counted_kind);
+                connection_changed |= session_connection_changed;
+                connection_data.sessions.swap_remove(session_index);
+                terminated.push((token.clone(), addrs, removed_streams));
+            }
+
+            // Plain / orphan streams (no session row, or leftover after session remove) for other
+            // virtual_ids on this client IP - same auto-close intent as upstream zap connection fix.
+            let orphan_idxs: Vec<usize> = connection_data
+                .streams
+                .iter()
+                .enumerate()
+                .filter(|(_, stream)| {
+                    stream.channel.virtual_id != keep_virtual_id
+                        && (single_client_user
+                            || Self::stream_matches_client_ip(
+                                stream,
+                                client_ip,
+                                client_ip_addr,
+                                &normalized_client_ip,
+                            ))
+                })
+                .map(|(idx, _)| idx)
+                .collect();
+            if !orphan_idxs.is_empty() {
+                let mut addrs = Vec::new();
+                let mut removed_streams = Vec::new();
+                let mut reservation_tokens: Vec<String> = Vec::new();
+                for idx in orphan_idxs.into_iter().rev() {
+                    let stream = connection_data.streams.swap_remove(idx);
+                    if let Some(kind) = connection_data.stream_kinds.remove(&stream.uid) {
+                        connection_data.decrement_kind(kind);
+                        connection_changed = true;
+                    }
+                    connection_data.stream_normal_priorities.remove(&stream.uid);
+                    if let Some(token) = stream.session_token.as_ref() {
+                        if !reservation_tokens.iter().any(|existing| existing == token) {
+                            reservation_tokens.push(token.clone());
+                        }
+                        Self::clear_session_counted(connection_data, token);
+                    }
+                    if !addrs.contains(&stream.addr) {
+                        addrs.push(stream.addr);
+                    }
+                    removed_streams.push((stream.addr, stream.uid));
+                }
+                if reservation_tokens.is_empty() {
+                    terminated.push((String::new(), addrs, removed_streams));
+                } else {
+                    for token in reservation_tokens {
+                        terminated.push((token, addrs.clone(), removed_streams.clone()));
+                    }
+                }
+            }
+
+            // Counted UserSession leases without an active StreamInfo row (ghost connections).
+            // Must run even when tokens_to_remove / orphans were empty — zap can drop preserved
+            // rows without emitting Connections, leaving streamless Active leases behind.
+            let (streamless_changed, streamless_terminated) = Self::release_streamless_counted_leases_for_zap(
+                connection_data,
+                client_ip,
+                client_ip_addr,
+                &normalized_client_ip,
+                client_fingerprint,
+                keep_virtual_id,
+                single_client_user,
+            );
+            connection_changed |= streamless_changed;
+            terminated.extend(streamless_terminated);
+
+            // Belt-and-suspenders: if this client has no live (non-preserved) streams left but the
+            // connection counter is still elevated, force-release any remaining streamless counted
+            // leases for the matched client / single-client user.
+            let client_has_live_stream = connection_data.streams.iter().any(|stream| {
+                !stream.preserved
+                    && (single_client_user
+                        || Self::stream_matches_client_ip(
+                            stream,
+                            client_ip,
+                            client_ip_addr,
+                            &normalized_client_ip,
+                        ))
+            });
+            if !client_has_live_stream && connection_data.connections > 0 {
+                let (extra_changed, extra_terminated) = Self::release_streamless_counted_leases_for_zap(
+                    connection_data,
+                    client_ip,
+                    client_ip_addr,
+                    &normalized_client_ip,
+                    client_fingerprint,
+                    keep_virtual_id,
+                    single_client_user,
+                );
+                connection_changed |= extra_changed;
+                terminated.extend(extra_terminated);
+            }
+
+            if terminated.is_empty() && !connection_changed {
+                return Vec::new();
+            }
+
+            if connection_data.connections == 0 && connection_data.streams.is_empty() {
+                connection_data.granted_grace = false;
+                connection_data.grace_ts = 0;
+            }
+
+            let promotions = Self::collect_promotions_after_capacity_release(connection_data);
+            let divergence_snapshot = Self::collect_divergence_snapshot(connection_data, username);
+            drop(user_connections);
+            self.log_divergence_snapshot(divergence_snapshot).await;
+
+            (terminated, connection_changed, promotions)
+        };
+
+        if connection_changed {
+            self.log_active_user().await;
+        }
+        for action in promotions {
+            self.emit_promotion_update(username, action).await;
+        }
+        if !terminated.is_empty() {
+            info!(
+                "Zap-terminated {} other-channel session/stream group(s) for user {username} at client_ip {client_ip} (keep virtual_id {keep_virtual_id})",
+                terminated.len()
+            );
+        }
+        terminated
+    }
+
+    /// Release counted leases that have no active (non-preserved) StreamInfo row.
+    ///
+    /// Zap can remove preserved stream rows without clearing the corresponding Active /
+    /// GraceActive session lease, leaving ghost `active_user_connections`. Includes
+    /// `keep_virtual_id` sessions when they are streamless ghosts (unlike the other-channel
+    /// session sweep, which skips keep_virtual_id).
+    fn release_streamless_counted_leases_for_zap(
+        connection_data: &mut UserConnectionData,
+        client_ip: &str,
+        client_ip_addr: Option<IpAddr>,
+        normalized_client_ip: &str,
+        client_fingerprint: Option<&str>,
+        keep_virtual_id: u32,
+        single_client_user: bool,
+    ) -> (bool, Vec<(String, Vec<SocketAddr>, Vec<(SocketAddr, u32)>)>) {
+        let _ = keep_virtual_id; // intentionally not excluded — ghost keep-channel leases too
+        let tokens: Vec<String> = connection_data
+            .sessions
+            .iter()
+            .filter(|session| {
+                session.lifecycle.is_counted()
+                    && !Self::session_has_active_stream(connection_data, session.token.as_str())
+                    && (single_client_user
+                        || Self::session_matches_client(
+                            session,
+                            &connection_data.streams,
+                            client_ip,
+                            client_ip_addr,
+                            normalized_client_ip,
+                            client_fingerprint,
+                        ))
+            })
+            .map(|session| session.token.clone())
+            .collect();
+
+        let mut connection_changed = false;
+        let mut terminated = Vec::with_capacity(tokens.len());
+
+        for token in tokens {
+            let Some(session_index) = connection_data.sessions.iter().position(|s| s.token == token) else {
+                continue;
+            };
+
+            let kind = connection_data.sessions[session_index]
+                .connection_kind
+                .unwrap_or(ConnectionKind::Normal);
+            let mut addrs = Vec::new();
+            let session_addr = connection_data.sessions[session_index].addr;
+            if !session_addr.ip().is_unspecified() {
+                addrs.push(session_addr);
+            }
+            for addr in &connection_data.sessions[session_index].active_addrs {
+                if !addrs.contains(addr) {
+                    addrs.push(*addr);
+                }
+            }
+
+            connection_data.decrement_kind(kind);
+            connection_changed = true;
+            Self::clear_session_counted_without_stream(connection_data, &token);
+            connection_data.sessions.swap_remove(session_index);
+            terminated.push((token, addrs, Vec::new()));
+        }
+
+        (connection_changed, terminated)
+    }
+
+    fn parse_client_ip(client_ip: &str) -> Option<IpAddr> {
+        let primary = client_ip.split(',').next().unwrap_or(client_ip).trim();
+        let primary = strip_port(primary);
+        primary
+            .parse::<IpAddr>()
+            .ok()
+            .map(|ip| match ip {
+                IpAddr::V6(v6) => v6.to_ipv4_mapped().map(IpAddr::V4).unwrap_or(ip),
+                other => other,
+            })
+    }
+
+    fn normalize_client_ip(client_ip: &str) -> String {
+        let primary = client_ip.split(',').next().unwrap_or(client_ip).trim();
+        let stripped = strip_port(primary);
+        match stripped.parse::<IpAddr>() {
+            Ok(IpAddr::V6(v6)) => v6.to_ipv4_mapped().map(|v4| v4.to_string()).unwrap_or_else(|| stripped.into_owned()),
+            _ => stripped.into_owned(),
+        }
+    }
+
+    fn stream_matches_client_ip(
+        stream: &StreamInfo,
+        client_ip: &str,
+        client_ip_addr: Option<IpAddr>,
+        normalized_client_ip: &str,
+    ) -> bool {
+        let stream_normalized = Self::normalize_client_ip(&stream.client_ip);
+        if stream.client_ip == client_ip
+            || stream.client_ip == normalized_client_ip
+            || stream_normalized == normalized_client_ip
+            || strip_port(&stream.client_ip) == normalized_client_ip
+        {
+            return true;
+        }
+        if let Some(ip) = client_ip_addr {
+            if stream.addr.ip() == ip {
+                return true;
+            }
+            if let Ok(stream_ip) = stream_normalized.parse::<IpAddr>() {
+                return stream_ip == ip;
+            }
+        }
+        false
+    }
+
+    fn session_matches_client(
+        session: &UserSession,
+        streams: &[StreamInfo],
+        client_ip: &str,
+        client_ip_addr: Option<IpAddr>,
+        normalized_client_ip: &str,
+        client_fingerprint: Option<&str>,
+    ) -> bool {
+        if let Some(fingerprint) = client_fingerprint.filter(|key| !key.is_empty()) {
+            // Logical session tokens embed fingerprint.key; socket-bound tokens use addr|user|vid.
+            if session.token.contains(fingerprint) {
+                return true;
+            }
+            // Fingerprint is `{client_ip}|{ua}` - match by IP prefix when UA differs slightly.
+            if let Some((fp_ip, _)) = fingerprint.split_once('|') {
+                let fp_ip_norm = Self::normalize_client_ip(fp_ip);
+                if !fp_ip_norm.is_empty() && fp_ip_norm == normalized_client_ip {
+                    // Fall through to stream/IP checks rather than treating as automatic match.
+                }
+            }
+        }
+
+        let addr_matches = |addr: &SocketAddr| {
+            if let Some(ip) = client_ip_addr {
+                let addr_ip = match addr.ip() {
+                    IpAddr::V6(v6) => v6.to_ipv4_mapped().map(IpAddr::V4).unwrap_or(IpAddr::V6(v6)),
+                    other => other,
+                };
+                if addr_ip == ip {
+                    return true;
+                }
+            }
+            strip_port(&addr.to_string()) == normalized_client_ip || addr.ip().to_string() == client_ip
+        };
+
+        if addr_matches(&session.addr) || session.active_addrs.iter().any(addr_matches) {
+            return true;
+        }
+
+        streams.iter().any(|stream| {
+            let linked = stream.session_token.as_deref() == Some(session.token.as_str())
+                || stream.channel.virtual_id == session.virtual_id;
+            linked && Self::stream_matches_client_ip(stream, client_ip, client_ip_addr, normalized_client_ip)
+        })
+    }
+
     /// Terminates the session and all associated streams for a playback.
