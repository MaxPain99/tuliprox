+    /// Terminate soft-preserved (and still-active) sessions for other channels when the
+    /// same user+IP activates a new `virtual_id`. Frees admission capacity, clears provider
+    /// reservations, closes leftover sockets, and notifies the Streams panel immediately.
+    pub async fn terminate_other_channel_sessions_for_client(
+        &self,
+        username: &str,
+        client_ip: &str,
+        keep_virtual_id: VirtualId,
+    ) {
+        let terminated = self
+            .user_manager
+            .terminate_other_channel_sessions_for_client_ip(username, client_ip, keep_virtual_id)
+            .await;
+        if terminated.is_empty() {
+            return;
+        }
+
+        let mut closed_addrs = HashSet::new();
+        for (session_token, addrs) in terminated {
+            self.provider_manager.clear_provider_reservation(&session_token).await;
+            for addr in addrs {
+                if !closed_addrs.insert(addr) {
+                    continue;
+                }
+                let _ = self.close_connection_with_reason(&addr, DisconnectReason::ClientClosed);
+                self.provider_manager.release_connection(&addr).await;
+                self.shared_stream_manager.release_connection(&addr, true).await;
+                self.event_manager
+                    .send_event(EventMessage::ActiveUser(ActiveUserConnectionChange::Disconnected(addr)));
+            }
+        }
+        notify_capacity(self.capacity_notify.as_ref());
+    }
