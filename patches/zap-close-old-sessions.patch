+/// Channel zap: drop soft-preserved sessions, HLS origin leases, and Streams rows for
+/// other `virtual_id`s of this user+player immediately (not after `hls_session_ttl`).
+pub(crate) async fn zap_close_other_channel_playback(
+    app_state: &Arc<AppState>,
+    username: &str,
+    fingerprint: &Fingerprint,
+    keep_virtual_id: VirtualId,
+) {
+    app_state
+        .connection_manager
+        .terminate_other_channel_sessions_for_client(
+            username,
+            &fingerprint.client_ip,
+            Some(fingerprint.key.as_str()),
+            keep_virtual_id,
+        )
+        .await;
+    app_state
+        .hls_proxy
+        .terminate_other_channel_hls_for_client(
+            &app_state.active_provider,
+            app_state.connection_manager.as_ref(),
+            username,
+            &fingerprint.key,
+            keep_virtual_id,
+        )
+        .await;
+}
