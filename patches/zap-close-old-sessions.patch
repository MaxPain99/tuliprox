+    /// On channel zap, tear down HLS access leases / origin bindings for other
+    /// `virtual_id`s of the same user+player family so provider account I/O and
+    /// `hls-cache:` reservations do not linger until session idle TTL.
+    pub async fn terminate_other_channel_hls_for_client(
+        &self,
+        active_provider: &Arc<ActiveProviderManager>,
+        connection_manager: &ConnectionManager,
+        username: &str,
+        client_fingerprint: &str,
+        keep_virtual_id: u32,
+    ) {
+        if !self.is_enabled() {
+            return;
+        }
+
+        let targets = {
+            let access_leases = self.access_leases.read().await;
+            access_leases.other_channel_leases_for_client(username, client_fingerprint, keep_virtual_id)
+        };
+        if targets.is_empty() {
+            return;
+        }
+
+        let mut proxy_sessions = HashSet::new();
+        for (lease_id, proxy_session_id) in &targets {
+            let _ = self
+                .deny_access_lease(
+                    lease_id,
+                    HlsAccessLeaseDenialMode::ImmediateRuntimePolicyEnd {
+                        reason: HlsRuntimeCustomTailReason::SessionOrLeaseExpired,
+                    },
+                )
+                .await;
+            proxy_sessions.insert(proxy_session_id.clone());
+        }
+
+        let now_ms = current_time_millis();
+        for proxy_session_id in proxy_sessions {
+            self.cleanup_proxy_session_state(&proxy_session_id, "channel-zap").await;
+            let Some(session) = self.sessions.get_by_proxy_session_id(&proxy_session_id).await else {
+                continue;
+            };
+            let (binding, provider_handle) = {
+                let mut session_guard = session.write().await;
+                let binding = session_guard.origin_account_binding.as_mut().map(|binding| {
+                    binding.detach(super::HlsOriginAccountDetachedReason::Cleanup, now_ms);
+                    binding.clone()
+                });
+                let provider_handle = session_guard
+                    .origin_account_io_lease
+                    .as_mut()
+                    .and_then(super::HlsOriginAccountIoLease::take_provider_handle);
+                session_guard.origin_account_io_lease = None;
+                session_guard.invalidate_queued_origin_work();
+                (binding, provider_handle)
+            };
+            if let Some(handle) = provider_handle {
+                connection_manager.release_provider_handle(Some(handle)).await;
+            }
+            if let Some(binding) = binding {
+                active_provider.clear_provider_reservation(&binding.session_owner).await;
+            }
+            debug!(
+                "HLS channel-zap cleaned proxy session {} for user {username} (keep virtual_id {keep_virtual_id})",
+                safe_proxy_session_id(&proxy_session_id)
+            );
+        }
+    }
