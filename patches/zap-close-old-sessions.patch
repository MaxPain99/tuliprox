+    /// On channel zap (`Activate` for a new `virtual_id`), drop other sessions for the
+    /// same user + client (IP and/or fingerprint key) so soft-preserved adaptive/HLS/Catchup
+    /// rows and provider pins do not linger until `hls_session_ttl`.
+    ///
+    /// Same-channel segment gaps keep the same `virtual_id` and are not terminated.
+    /// Other devices (different client IP / fingerprint) are left alone.
+    ///
+    /// Returns `(session_token, socket addrs, removed stream addr/uid pairs)` for each
+    /// removed session so the caller can close sockets, clear provider reservations, and
+    /// hard-remove Streams panel rows.
+    pub async fn terminate_other_channel_sessions_for_client_ip(
+        &self,
+        username: &str,
+        client_ip: &str,
+        client_fingerprint: Option<&str>,
+        keep_virtual_id: u32,
+    ) -> Vec<(String, Vec<SocketAddr>, Vec<(SocketAddr, u32)>)> {
+        let client_ip_addr = client_ip.parse::<IpAddr>().ok();
+        let normalized_client_ip = strip_port(client_ip);
+
+        let (terminated, connection_changed, promotions) = {
+            let mut user_connections = self.connections.write().await;
+            let Some(connection_data) = user_connections.by_key.get_mut(username) else {
+                return Vec::new();
+            };
+
+            let tokens_to_remove: Vec<String> = connection_data
+                .sessions
+                .iter()
+                .filter(|session| {
+                    session.virtual_id != keep_virtual_id
+                        && Self::session_matches_client(
+                            session,
+                            &connection_data.streams,
+                            client_ip,
+                            client_ip_addr,
+                            normalized_client_ip.as_ref(),
+                            client_fingerprint,
+                        )
+                })
+                .map(|session| session.token.clone())
+                .collect();
+
+            if tokens_to_remove.is_empty() {
+                return Vec::new();
+            }
+
+            let mut terminated = Vec::with_capacity(tokens_to_remove.len());
+            let mut connection_changed = false;
+
+            for token in &tokens_to_remove {
+                let Some(session_index) = connection_data.sessions.iter().position(|s| s.token == *token) else {
+                    continue;
+                };
+
+                let mut addrs = Vec::new();
+                let mut removed_streams = Vec::new();
+                let session_addr = connection_data.sessions[session_index].addr;
+                if !session_addr.ip().is_unspecified() {
+                    addrs.push(session_addr);
+                }
+                for addr in &connection_data.sessions[session_index].active_addrs {
+                    if !addrs.contains(addr) {
+                        addrs.push(*addr);
+                    }
+                }
+                for stream in connection_data
+                    .streams
+                    .iter()
+                    .filter(|stream| stream.session_token.as_deref() == Some(token.as_str()))
+                {
+                    if !addrs.contains(&stream.addr) {
+                        addrs.push(stream.addr);
+                    }
+                    removed_streams.push((stream.addr, stream.uid));
+                }
+
+                let counted_kind = connection_data.sessions[session_index]
+                    .lifecycle
+                    .is_counted()
+                    .then(|| connection_data.sessions[session_index].connection_kind.unwrap_or(ConnectionKind::Normal));
+                let (_, session_connection_changed) =
+                    connection_data.remove_streams_for_session_and_release_counted(token, counted_kind);
+                connection_changed |= session_connection_changed;
+                connection_data.sessions.swap_remove(session_index);
+                terminated.push((token.clone(), addrs, removed_streams));
+            }
+
+            if connection_data.connections == 0 && connection_data.streams.is_empty() {
+                connection_data.granted_grace = false;
+                connection_data.grace_ts = 0;
+            }
+
+            let promotions = Self::collect_promotions_after_capacity_release(connection_data);
+            let divergence_snapshot = Self::collect_divergence_snapshot(connection_data, username);
+            drop(user_connections);
+            self.log_divergence_snapshot(divergence_snapshot).await;
+
+            (terminated, connection_changed, promotions)
+        };
+
+        if connection_changed {
+            self.log_active_user().await;
+        }
+        for action in promotions {
+            self.emit_promotion_update(username, action).await;
+        }
+        if !terminated.is_empty() {
+            debug!(
+                "Zap-terminated {} other-channel session(s) for user {username} at client_ip {client_ip} (keep virtual_id {keep_virtual_id})",
+                terminated.len()
+            );
+        }
+        terminated
+    }
+
+    fn session_matches_client(
+        session: &UserSession,
+        streams: &[StreamInfo],
+        client_ip: &str,
+        client_ip_addr: Option<IpAddr>,
+        normalized_client_ip: &str,
+        client_fingerprint: Option<&str>,
+    ) -> bool {
+        if let Some(fingerprint) = client_fingerprint.filter(|key| !key.is_empty()) {
+            // Logical session tokens embed fingerprint.key; socket-bound tokens use addr|user|vid.
+            if session.token.contains(fingerprint) {
+                return true;
+            }
+        }
+
+        let addr_matches = |addr: &SocketAddr| {
+            if let Some(ip) = client_ip_addr {
+                if addr.ip() == ip {
+                    return true;
+                }
+            }
+            strip_port(&addr.to_string()) == normalized_client_ip || addr.ip().to_string() == client_ip
+        };
+
+        if addr_matches(&session.addr) || session.active_addrs.iter().any(addr_matches) {
+            return true;
+        }
+
+        streams.iter().any(|stream| {
+            stream.session_token.as_deref() == Some(session.token.as_str())
+                && (stream.client_ip == client_ip
+                    || stream.client_ip == normalized_client_ip
+                    || strip_port(&stream.client_ip) == normalized_client_ip
+                    || addr_matches(&stream.addr))
+        })
+    }
