+    #[tokio::test]
+    async fn zap_activate_releases_streamless_counted_ghost_leases() {
+        let config = Config::default();
+        let geoip = Arc::new(ArcSwapOption::<GeoIp>::default());
+        let event_manager = Arc::new(EventManager::new());
+        let manager = ActiveUserManager::new(&config, &geoip, &event_manager);
+
+        let addr_a: SocketAddr = "127.0.0.1:55440".parse().unwrap();
+        let addr_b: SocketAddr = "127.0.0.1:55441".parse().unwrap();
+        let addr_keep: SocketAddr = "127.0.0.1:55442".parse().unwrap();
+        let mut user = ProxyUserCredentials::default();
+        user.username = "user-zap-streamless-ghost".to_string();
+        user.max_connections = 4;
+
+        let token_a = manager
+            .create_user_session(CreateUserSessionParams {
+                user: &user,
+                session_token: "tok-ghost-a",
+                virtual_id: 9401,
+                provider: "provider-a",
+                stream_url: "http://localhost/a.ts",
+                addr: &addr_a,
+                connection_permission: UserConnectionPermission::Allowed,
+                connection_kind: Some(ConnectionKind::Normal),
+                socket_bound: false,
+            })
+            .await;
+        let token_b = manager
+            .create_user_session(CreateUserSessionParams {
+                user: &user,
+                session_token: "tok-ghost-b",
+                virtual_id: 9402,
+                provider: "provider-b",
+                stream_url: "http://localhost/b.ts",
+                addr: &addr_b,
+                connection_permission: UserConnectionPermission::Allowed,
+                connection_kind: Some(ConnectionKind::Normal),
+                socket_bound: false,
+            })
+            .await;
+        let token_keep = manager
+            .create_user_session(CreateUserSessionParams {
+                user: &user,
+                session_token: "tok-ghost-keep",
+                virtual_id: 9403,
+                provider: "provider-c",
+                stream_url: "http://localhost/c.ts",
+                addr: &addr_keep,
+                connection_permission: UserConnectionPermission::Allowed,
+                connection_kind: Some(ConnectionKind::Normal),
+                socket_bound: false,
+            })
+            .await;
+
+        // Artificially leave Active counted leases with NO streams (ghost connections).
+        {
+            let mut connections = manager.connections.write().await;
+            let data = connections.by_key.get_mut(&user.username).unwrap();
+            for token in [&token_a, &token_b, &token_keep] {
+                let session = data.sessions.iter_mut().find(|s| s.token == *token).unwrap();
+                session.lifecycle = PlaybackLifecycle::Active;
+                data.increment_kind(ConnectionKind::Normal);
+            }
+        }
+        assert_eq!(manager.user_connections(&user.username).await, 3);
+        {
+            let connections = manager.connections.read().await;
+            let data = connections.by_key.get(&user.username).unwrap();
+            assert!(data.streams.is_empty(), "ghost fixture must have empty Streams list");
+        }
+
+        let terminated = manager
+            .terminate_other_channel_sessions_for_client_ip(&user.username, "127.0.0.1", None, 9403)
+            .await;
+        assert!(
+            !terminated.is_empty(),
+            "streamless ghost leases must be zap-terminated"
+        );
+        assert_eq!(
+            manager.user_connections(&user.username).await,
+            0,
+            "ghost active_user_connections must return to 0"
+        );
+        assert!(manager.get_and_update_user_session(&user.username, &token_a).await.is_none());
+        assert!(manager.get_and_update_user_session(&user.username, &token_b).await.is_none());
+        assert!(
+            manager.get_and_update_user_session(&user.username, &token_keep).await.is_none(),
+            "keep_virtual_id streamless ghost lease must also be released"
+        );
+        {
+            let connections = manager.connections.read().await;
+            if let Some(data) = connections.by_key.get(&user.username) {
+                assert!(
+                    data.sessions.iter().all(|session| !session.lifecycle.is_counted()),
+                    "no streamless counted sessions should remain"
+                );
+                assert_eq!(data.connections, 0);
+                assert!(data.streams.is_empty());
+            }
+        }
+    }
